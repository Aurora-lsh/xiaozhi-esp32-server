+void OttoEmojiDisplay::SetupReadableDisplay() {
+    DisplayLockGuard lock(this);
+    if (!chat_message_label_ || !bottom_bar_)
+        return;
+    auto* font = static_cast<LvglTheme*>(current_theme_)->text_font()->font();
+    int height = font->line_height * 2 + 4;
+    lv_obj_set_height(bottom_bar_, height + 12);
+    lv_obj_set_style_bg_opa(bottom_bar_, LV_OPA_COVER, 0);
+    lv_obj_set_size(chat_message_label_, width_ - 16, height);
+    lv_obj_set_style_text_line_space(chat_message_label_, 4, 0);
+    lv_label_set_long_mode(chat_message_label_, LV_LABEL_LONG_WRAP);
+    lv_obj_align(chat_message_label_, LV_ALIGN_TOP_MID, 0, 4);
+    // Keep the full GIF in the space between the status and subtitles.
+    lv_obj_align(emoji_box_, LV_ALIGN_CENTER, 0, -20);
+    lv_obj_set_style_transform_scale(emoji_box_, 144, 0);
+    lv_obj_set_style_transform_pivot_x(emoji_box_, LV_PCT(50), 0);
+    lv_obj_set_style_transform_pivot_y(emoji_box_, LV_PCT(50), 0);
+    subtitle_timer_ = lv_timer_create(
+        [](lv_timer_t* timer) {
+            static_cast<OttoEmojiDisplay*>(lv_timer_get_user_data(timer))->ShowNextSubtitlePage();
+        },
+        2800, this);
+    lv_timer_pause(subtitle_timer_);
+}
+
+void OttoEmojiDisplay::ShowNextSubtitlePage() {
+    if (++subtitle_page_ < subtitle_pages_.size()) {
+        lv_label_set_text(chat_message_label_, subtitle_pages_[subtitle_page_].c_str());
+    }
+    if (subtitle_page_ + 1 >= subtitle_pages_.size())
+        lv_timer_pause(subtitle_timer_);
+}
+#endif
+
+void OttoEmojiDisplay::SetChatMessage(const char* role, const char* content) {
+#if CONFIG_OTTO_READABLE_DISPLAY
+    DisplayLockGuard lock(this);
+    if (!chat_message_label_ || !subtitle_timer_)
+        return;
+    lv_timer_pause(subtitle_timer_);
+    // Bound allocations and layout work for a malformed server message.
+    std::string text = content ? std::string(content, strnlen(content, 2048)) : "";
+    const auto* font = lv_obj_get_style_text_font(chat_message_label_, LV_PART_MAIN);
+    auto measure = [font](const std::string& line) {
+        lv_point_t size;
+        lv_text_get_size(&size, line.c_str(), font, 0, 4, LV_COORD_MAX, LV_TEXT_FLAG_NONE);
+        return size.x;
+    };
+    subtitle_pages_ = MakeSubtitlePages(text, width_ - 16, measure);
+    subtitle_page_ = 0;
+    lv_label_set_text(chat_message_label_,
+                      subtitle_pages_.empty() ? "" : subtitle_pages_[0].c_str());
+    if (subtitle_pages_.size() > 1) {
+        lv_timer_reset(subtitle_timer_);
+        lv_timer_resume(subtitle_timer_);
+    }
+#else
+    SpiLcdDisplay::SetChatMessage(role, content);
+#endif
+}
+
+void OttoEmojiDisplay::ClearChatMessages() {
+#if CONFIG_OTTO_READABLE_DISPLAY
+    SetChatMessage("system", "");
+#else
+    SpiLcdDisplay::ClearChatMessages();
+#endif
 }
 

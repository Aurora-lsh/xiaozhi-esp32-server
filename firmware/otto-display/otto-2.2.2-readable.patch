diff --git a/main/boards/otto-robot/subtitle_pages.h b/main/boards/otto-robot/subtitle_pages.h
new file mode 100644
index 0000000..6d90926
--- /dev/null
+++ b/main/boards/otto-robot/subtitle_pages.h
@@ -0,0 +1,47 @@
+#pragma once
+
+#include <string>
+#include <utility>
+#include <vector>
+
+// Wrap at UTF-8 character boundaries. The caller supplies the current font's
+// pixel measurement; no fixed-width assumption is made for Chinese or Latin.
+template <typename Measure>
+std::vector<std::string> MakeSubtitlePages(const std::string& text, int width, Measure measure) {
+    std::vector<std::string> pages;
+    std::string line, page;
+    int lines = 0;
+    auto finish_line = [&]() {
+        if (lines != 0)
+            page += '\n';
+        page += line;
+        line.clear();
+        if (++lines == 2) {
+            pages.push_back(std::move(page));
+            page.clear();
+            lines = 0;
+        }
+    };
+    for (size_t i = 0; i < text.size();) {
+        unsigned char first = text[i];
+        size_t bytes = first < 0x80 ? 1 : first < 0xE0 ? 2 : first < 0xF0 ? 3 : 4;
+        if (i + bytes > text.size())
+            break;
+        std::string glyph = text.substr(i, bytes);
+        i += bytes;
+        if (glyph == "\r")
+            continue;
+        if (glyph == "\n") {
+            finish_line();
+            continue;
+        }
+        if (!line.empty() && measure(line + glyph) > width)
+            finish_line();
+        line += glyph;
+    }
+    if (!line.empty())
+        finish_line();
+    if (lines != 0)
+        pages.push_back(std::move(page));
+    return pages;
+}
